# Copy to .env and fill in. Only OPENAI_API_KEY is required, and only for the
# Advisor (chat) tab — Explore data, Risk profile and Knowledge graph work
# without it.

OPENAI_API_KEY=sk-...

# --- optional ---------------------------------------------------------------

# Chat models. The lead agent plans and synthesises; the subagents do the
# retrieval and data work.
ARM_LEAD_MODEL=gpt-4o
ARM_SUBAGENT_MODEL=gpt-4o-mini

# Paper retrieval: tfidf (offline, no key) | embeddings (needs a key + the
# data/papers/embeddings.npz built by `python etl/embed_papers.py`) | auto.
ARM_RETRIEVER=auto

# Set to 0 to run the data/papers/graph tools in-process instead of spawning
# the three MCP servers as subprocesses (identical behaviour, easier to debug).
ARM_MCP=1

# --- optional data sources (extra planned indicators) ----------------------

# EM-DAT disaster impact. Register free at https://public.emdat.be/ then:
# EMDAT_API_TOKEN=...

# OECD climate adaptation finance. The OECD SDMX API needs an exact dataflow
# that changes between releases; point the fetcher at a working CSV query:
# OECD_CLIMATE_DATA_URL=https://sdmx.oecd.org/public/rest/data/...
